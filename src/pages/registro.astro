---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../config/site.config.js';
import '../styles/auth-card.css';
---

<MainLayout title={`Registro | ${SITE.name}`} hideAuthButton={true}>
  <section class="auth-page">
    <div class="auth-card">
      <div class="auth-header">
        <span class="material-symbols-outlined auth-icon">person_add</span>
        <h1>Crear cuenta</h1>
        <p>Accede con tu cuenta de Google para registrarte en {SITE.name}</p>
      </div>
      <auth-form></auth-form>
    </div>
  </section>
</MainLayout>

<script>
  import '../components/auth-form.js';
</script>
