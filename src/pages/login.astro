---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../config/site.config.js';
import '../styles/auth-card.css';
---

<MainLayout title={`Login | ${SITE.name}`} hideAuthButton={true}>
  <section class="auth-page">
    <div class="auth-card">
      <div class="auth-header">
        <img src="/logo.svg" alt={SITE.name} class="auth-logo" />
        <h1>Acceder</h1>
        <p>Inicia sesion en {SITE.name}</p>
      </div>
      <auth-form></auth-form>
    </div>
  </section>
</MainLayout>

<script>
  import '../components/auth-form.js';
</script>
